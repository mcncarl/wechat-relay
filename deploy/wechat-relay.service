[Unit]
Description=Self-hosted WeChat Official Account draft relay
Documentation=https://github.com/mcncarl/wechat-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/wechat-relay
EnvironmentFile=/etc/wechat-relay/wechat-relay.env
Environment=HOST=127.0.0.1
Environment=PORT=18794
Environment=DB_PATH=/var/lib/wechat-relay/idempotency.sqlite3
ExecStart=/usr/bin/node /opt/wechat-relay/src/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
StateDirectory=wechat-relay
StateDirectoryMode=0700
UMask=0077
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
ProcSubset=pid
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
